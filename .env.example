# Copy this file to .env and fill in your values
# Get your OpenAI API key at: https://platform.openai.com/api-keys

OPENAI_API_KEY=your_openai_api_key_here

# Port the web UI runs on (default: 3000)
PORT=3000

# AI model to use
# gpt-4o        → Most capable, best for complex tasks (recommended)
# gpt-4o-mini   → Fast and cheap, good for simple tasks
# o3-mini       → Strong reasoning model
AI_MODEL=gpt-4o

# The working directory the agent operates on
# Leave blank to use wherever you launch the server from (recommended)
WORK_DIR=

# Max characters the agent can read from a single file (default: 100000)
MAX_FILE_SIZE=100000
